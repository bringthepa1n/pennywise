<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PennyWise.Converters"
             x:Class="PennyWise.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Base palette (fixed tonal values) -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />

                <!-- Active colour roles; replaced at runtime by ThemeService. -->
                <ResourceDictionary Source="Resources/Styles/themes/LightTheme.xaml" />

                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
