<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Material Design 3 colour system for PennyWise.
        Seed colour: green (money / growth), mapped to the M3 roles.
        Light values come from the M3 tonal palette, dark values from the
        matching dark scheme. Every role has an "on-*" partner and container
        variants are provided where the UI uses them.
    -->

    <!-- Brand / seed -->
    <Color x:Key="Seed">#1B5E42</Color>

    <!-- Light scheme -->
    <Color x:Key="LightPrimary">#2E6B4F</Color>
    <Color x:Key="LightOnPrimary">#FFFFFF</Color>
    <Color x:Key="LightPrimaryContainer">#B1F1CE</Color>
    <Color x:Key="LightOnPrimaryContainer">#002114</Color>
    <Color x:Key="LightSecondary">#4E6355</Color>
    <Color x:Key="LightOnSecondary">#FFFFFF</Color>
    <Color x:Key="LightSecondaryContainer">#D0E8D7</Color>
    <Color x:Key="LightOnSecondaryContainer">#0B1F15</Color>
    <Color x:Key="LightTertiary">#3B6470</Color>
    <Color x:Key="LightOnTertiary">#FFFFFF</Color>
    <Color x:Key="LightTertiaryContainer">#BFE9F7</Color>
    <Color x:Key="LightOnTertiaryContainer">#001F27</Color>
    <Color x:Key="LightError">#BA1A1A</Color>
    <Color x:Key="LightOnError">#FFFFFF</Color>
    <Color x:Key="LightErrorContainer">#FFDAD6</Color>
    <Color x:Key="LightOnErrorContainer">#410002</Color>
    <Color x:Key="LightSurface">#F5FBF6</Color>
    <Color x:Key="LightOnSurface">#171D1A</Color>
    <Color x:Key="LightSurfaceVariant">#DBE5DD</Color>
    <Color x:Key="LightOnSurfaceVariant">#404943</Color>
    <Color x:Key="LightSurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="LightSurfaceContainerLow">#EFF5F0</Color>
    <Color x:Key="LightSurfaceContainer">#E9EFEA</Color>
    <Color x:Key="LightSurfaceContainerHigh">#E3E9E4</Color>
    <Color x:Key="LightOutline">#707973</Color>
    <Color x:Key="LightOutlineVariant">#C0C9C1</Color>
    <Color x:Key="LightPositive">#1E7A4B</Color>
    <Color x:Key="LightNegative">#B3261E</Color>
    <Color x:Key="LightWarning">#8A5100</Color>

    <!-- Dark scheme -->
    <Color x:Key="DarkPrimary">#96D5B4</Color>
    <Color x:Key="DarkOnPrimary">#003824</Color>
    <Color x:Key="DarkPrimaryContainer">#0F5238</Color>
    <Color x:Key="DarkOnPrimaryContainer">#B1F1CE</Color>
    <Color x:Key="DarkSecondary">#B4CCBD</Color>
    <Color x:Key="DarkOnSecondary">#203528</Color>
    <Color x:Key="DarkSecondaryContainer">#364B3E</Color>
    <Color x:Key="DarkOnSecondaryContainer">#D0E8D7</Color>
    <Color x:Key="DarkTertiary">#A3CDDA</Color>
    <Color x:Key="DarkOnTertiary">#033540</Color>
    <Color x:Key="DarkTertiaryContainer">#224C57</Color>
    <Color x:Key="DarkOnTertiaryContainer">#BFE9F7</Color>
    <Color x:Key="DarkError">#FFB4AB</Color>
    <Color x:Key="DarkOnError">#690005</Color>
    <Color x:Key="DarkErrorContainer">#93000A</Color>
    <Color x:Key="DarkOnErrorContainer">#FFDAD6</Color>
    <Color x:Key="DarkSurface">#0F1511</Color>
    <Color x:Key="DarkOnSurface">#DEE4DF</Color>
    <Color x:Key="DarkSurfaceVariant">#404943</Color>
    <Color x:Key="DarkOnSurfaceVariant">#C0C9C1</Color>
    <Color x:Key="DarkSurfaceContainerLowest">#0A0F0C</Color>
    <Color x:Key="DarkSurfaceContainerLow">#171D1A</Color>
    <Color x:Key="DarkSurfaceContainer">#1B211E</Color>
    <Color x:Key="DarkSurfaceContainerHigh">#262B28</Color>
    <Color x:Key="DarkOutline">#8A938C</Color>
    <Color x:Key="DarkOutlineVariant">#404943</Color>
    <Color x:Key="DarkPositive">#7FDBAB</Color>
    <Color x:Key="DarkNegative">#FFB4AB</Color>
    <Color x:Key="DarkWarning">#F2BD6B</Color>

    <!-- Default theme roles (light values; replaced at runtime by themes/*.xaml) -->
    <Color x:Key="Primary">#2E6B4F</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryContainer">#B1F1CE</Color>
    <Color x:Key="OnPrimaryContainer">#002114</Color>
    <Color x:Key="Secondary">#4E6355</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="SecondaryContainer">#D0E8D7</Color>
    <Color x:Key="OnSecondaryContainer">#0B1F15</Color>
    <Color x:Key="Tertiary">#3B6470</Color>
    <Color x:Key="OnTertiary">#FFFFFF</Color>
    <Color x:Key="TertiaryContainer">#BFE9F7</Color>
    <Color x:Key="OnTertiaryContainer">#001F27</Color>
    <Color x:Key="Error">#BA1A1A</Color>
    <Color x:Key="OnError">#FFFFFF</Color>
    <Color x:Key="ErrorContainer">#FFDAD6</Color>
    <Color x:Key="OnErrorContainer">#410002</Color>
    <Color x:Key="Surface">#F5FBF6</Color>
    <Color x:Key="OnSurface">#171D1A</Color>
    <Color x:Key="SurfaceVariant">#DBE5DD</Color>
    <Color x:Key="OnSurfaceVariant">#404943</Color>
    <Color x:Key="SurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLow">#EFF5F0</Color>
    <Color x:Key="SurfaceContainer">#E9EFEA</Color>
    <Color x:Key="SurfaceContainerHigh">#E3E9E4</Color>
    <Color x:Key="Outline">#707973</Color>
    <Color x:Key="OutlineVariant">#C0C9C1</Color>
    <Color x:Key="Positive">#1E7A4B</Color>
    <Color x:Key="Negative">#B3261E</Color>
    <Color x:Key="Warning">#8A5100</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>


    <!-- Shape radii, referenced by Border StrokeShape and styles -->
    <x:Double x:Key="RadiusCard">20</x:Double>
    <x:Double x:Key="RadiusPill">999</x:Double>
    <CornerRadius x:Key="RadiusCardCorner">20</CornerRadius>
    <CornerRadius x:Key="RadiusPillCorner">999</CornerRadius>

</ResourceDictionary>
